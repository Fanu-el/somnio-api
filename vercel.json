{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run prisma:generate",
  "functions": {
    "src/index.ts": {
      "includeFiles": "prisma/**/*.prisma"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/src/index.ts"
    }
  ]
}
